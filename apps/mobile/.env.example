# 앱이 부르는 백엔드 주소. 앱에는 웹의 개발 프록시가 없으니 항상 넣는다
EXPO_PUBLIC_API_BASE_URL=https://dev.api.pabom.app

# 소셜 로그인 SDK 키. 모두 앱 안에 들어가는 공개 값이다 (비밀 값은 백엔드에만 둔다).
# 비우면 그 서비스는 브라우저 로그인(백엔드 app-callback)으로 간다. 바꾸면 네이티브를 다시 빌드한다
# 카카오 디벨로퍼스 > 앱 > 플랫폼 키 > 네이티브 앱 키 (개발 앱 "파봄(개발)": a038cd46cd916bde969f61bed9071734)
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
# 구글 클라우드 콘솔 > 클라이언트. 웹 클라이언트 ID는 백엔드 GOOGLE_CLIENT_ID 와 같은 값 (ID 토큰 검증 기준)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS 클라이언트 ID는 번들 ID마다 따로다 (운영 app.pabom.mobile, 개발 app.pabom.mobile.dev)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# 안드로이드 푸시(FCM) 설정 파일 경로. Firebase 콘솔 > 프로젝트 설정 > 안드로이드 앱(패키지명별)에서 받는다.
# EAS 빌드는 프로필 환경(development·preview / production)마다 파일 형식 변수로 넣는다. 비우면 안드로이드 푸시 토큰이 안 나온다
GOOGLE_SERVICES_JSON=
