# 로컬 개발 전용 백엔드 주소. Next 프록시(src/app/api/v1)가 /api/v1 요청을 여기로 넘긴다 (서버 전용)
API_PROXY_TARGET=https://dev.api.pabom.app
# 브라우저가 부르는 백엔드 주소. 개발·운영 서버 배포에서는 꼭 넣는다 (예: https://dev.api.pabom.app)
# 로컬과 데모 서버에서는 비운다 (로컬은 프록시로, 데모는 전부 목업으로)
NEXT_PUBLIC_API_BASE_URL=
# 백엔드에 아직 없는 API를 MSW로 가짜로 만든다 (enabled | disabled). 배포에서도 동작한다
NEXT_PUBLIC_API_MOCKING=enabled
# 목업 모드에서도 진짜 백엔드로 보낼 API 묶음 (쉼표로). 목록은 src/shared/config/env.ts API_LIVE_GROUPS
#   auth = 로그인·약관 동의, user = 내 정보·회원 탈퇴, species = 종·모프·관리 가이드라인,
#   pets = 개체 목록·등록·상세·수정·삭제, routine = 체크 리스트·완료/건너뛰기/미루기·오늘 할 일,
#   record = 기록 목록·추가·상세·정정·삭제·복구, file = 사진 업로드·조회 주소
# pets·routine·record·file은 같이 켠다 (한쪽만 진짜면 개체·파일 ID를 서로 몰라 사진 칸을 숨기고 일정이 비어 보인다).
# 인계 카드·개체 상태 바꾸기는 스웨거에 없어 항상 목업. 데모 서버는 비운다
NEXT_PUBLIC_API_LIVE=auth,user,species
# 웹 푸시용 VAPID 공개키
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
