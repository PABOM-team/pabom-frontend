diff --git a/ios/RNSScreen.mm b/ios/RNSScreen.mm
index 049fd22427b2bde17fd7ca59b8de65d0ee07b4b5..3be09c83395accb9240c79164b5a91ebed3ffb5a 100644
--- a/ios/RNSScreen.mm
+++ b/ios/RNSScreen.mm
@@ -1544,6 +1544,27 @@ - (void)viewWillDisappear:(BOOL)animated
     [self notifyTransitionProgress:0.0 closing:_closing goingForward:_goingForward];
     [self setupProgressNotification];
   }
+
+  // pabom: 화면이 스택에서 빠지는 게 확정되면 JS 에 바로 알린다.
+  // 기본 동작은 전환이 완전히 끝난 viewDidDisappear 에서야 알린다. 줌 전환은 손을 뗀 뒤 눈에 보이는 움직임이
+  // 끝나고도 완료까지 약 0.8~1초가 더 걸려, 그동안 JS 는 이전 화면이 열려 있다고 여겨 누른 화면 이동이 사라졌다.
+  // 네이티브 스택에서는 이미 빠진 뒤라(isNativelyDismissedFromContainer) JS 가 스택을 고쳐도 아무 일도 하지 않고,
+  // 전환 중 새로 쌓는 화면은 RNSScreenStack 이 전환이 끝날 때까지 미뤄 둔다
+  if ([self isMovingFromParentViewController] && self.transitionCoordinator != nil) {
+    if (self.transitionCoordinator.isInteractive) {
+      // 가장자리 스와이프처럼 손가락을 따라가는 동안에는 되돌아갈 수 있으니 손을 떼 확정될 때 알린다
+      __weak RNSScreen *weakSelf = self;
+      [self.transitionCoordinator
+          notifyWhenInteractionChangesUsingBlock:^(id<UIViewControllerTransitionCoordinatorContext> _Nonnull context) {
+            if (!context.isCancelled) {
+              [weakSelf notifyDismissedIfNeeded];
+            }
+          }];
+    } else {
+      // 이미 확정된 닫힘 (줌 전환을 손으로 밀어 놓은 뒤, 뒤로 버튼 등)
+      [self notifyDismissedIfNeeded];
+    }
+  }
 }
 
 - (void)viewDidAppear:(BOOL)animated
